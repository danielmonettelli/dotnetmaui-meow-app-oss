<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Meow.Views.BreedsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Meow.Controls"
    xmlns:converter="clr-namespace:Meow.Converters"
    xmlns:model="clr-namespace:Meow.Domain.Entities;assembly=Meow.Domain"
    xmlns:reusablecomponent="clr-namespace:Meow.ReusableComponents"
    xmlns:viewModel="clr-namespace:Meow.Presentation.ViewModels"
    x:DataType="viewModel:BreedsViewModel">

    <ContentPage.Resources>
        <converter:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        <Style x:Key="BreedChipBorderStyle" TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource violet_9_light}, Dark={StaticResource purple_3_dark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource violet_12_light}, Dark={StaticResource purple_9_dark}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Shell.TitleView>
        <reusablecomponent:TitleViewReusable />
    </Shell.TitleView>

    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <Grid
                Padding="12,20,12,12"
                RowDefinitions="50, 36, 240, 34, Auto, 12, Auto, 10, Auto, 12, Auto">
                <CollectionView
                    Grid.Row="0"
                    ItemsSource="{Binding Breeds}"
                    SelectedItem="{Binding SelectedBreed}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="12"
                            Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Breed">
                            <Border
                                Style="{StaticResource BreedChipBorderStyle}"
                                Padding="14"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0">
                                <Label
                                    Style="{StaticResource TxtSubtitle1_2}"
                                    Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--  Empty gallery state  -->
                <Border
                    Grid.Row="2"
                    BackgroundColor="{AppThemeBinding Light={StaticResource gray_4_light},
                                                      Dark={StaticResource gray_4_dark}}"
                    IsVisible="{Binding HasNoKittens}"
                    Padding="24"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow
                            Brush="#121212"
                            Offset="0,10"
                            Opacity="0.15"
                            Radius="10" />
                    </Border.Shadow>
                    <Grid
                        HorizontalOptions="Center"
                        RowDefinitions="Auto, Auto, Auto"
                        RowSpacing="8"
                        VerticalOptions="Center">
                        <Image
                            Grid.Row="0"
                            HeightRequest="60"
                            HorizontalOptions="Center"
                            Opacity="{AppThemeBinding Light=0.9, Dark=0.95}"
                            Source="{AppThemeBinding Light=icon_brand_light.png, Dark=icon_brand_dark.png}"
                            WidthRequest="60" />
                        <Label
                            Grid.Row="1"
                            FontFamily="Roboto#700"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            Text="No images available yet"
                            TextColor="{AppThemeBinding Light={StaticResource violet_9_light},
                                                        Dark={StaticResource purple_12_dark}}" />
                        <Label
                            Grid.Row="2"
                            FontFamily="Roboto#400"
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="There are no gallery photos for this breed right now."
                            TextColor="{AppThemeBinding Light={StaticResource gray_12_light},
                                                        Dark={StaticResource gray_12_dark}}" />
                    </Grid>
                </Border>

                <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding KittensByBreed}"
                    IsVisible="{Binding HasNoKittens, Converter={StaticResource InvertBooleanConverter}}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            HorizontalItemSpacing="16"
                            Orientation="Horizontal" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:Cat">
                            <Border
                                BackgroundColor="{AppThemeBinding Light={StaticResource gray_4_light},
                                                                  Dark={StaticResource gray_4_dark}}"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0">
                                <Grid WidthRequest="215">
                                    <Image
                                        Aspect="Center"
                                        Opacity="0.25"
                                        Source="icon_brand_bg.png" />
                                    <Image
                                        Aspect="AspectFill"
                                        Source="{Binding Url}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label
                    Grid.Row="4"
                    Style="{StaticResource TxtHeadline6_2}"
                    Text="{Binding SelectedBreed.Name}" />

                <controls:CustomStringSplitterView
                    Grid.Row="6"
                    InputText="{Binding SelectedBreed.Temperament}" />

                <Label
                    Grid.Row="8"
                    Style="{StaticResource TxtCaption_1}"
                    Text="{Binding SelectedBreed.Description}" />

                <Border
                    Grid.Row="10"
                    Padding="10"
                    BackgroundColor="Transparent"
                    Stroke="{AppThemeBinding Light={StaticResource violet_9_light},
                                             Dark={StaticResource purple_8_dark}}"
                    StrokeDashArray="3,2"
                    StrokeDashOffset="6"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="2">
                    <Grid
                        ColumnDefinitions="Auto, Auto"
                        ColumnSpacing="12"
                        RowDefinitions="Auto, Auto, Auto, Auto"
                        RowSpacing="6">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource TxtOverline_1}"
                            Text="Affection Level:" />

                        <controls:RatingView
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource RatingViewStyle}"
                            Value="{Binding SelectedBreed.Affection_level}" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource TxtOverline_1}"
                            Text="Adaptability:" />

                        <controls:RatingView
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource RatingViewStyle}"
                            Value="{Binding SelectedBreed.Adaptability}" />

                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource TxtOverline_1}"
                            Text="Child Friendly:" />

                        <controls:RatingView
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource RatingViewStyle}"
                            Value="{Binding SelectedBreed.Child_friendly}" />

                        <Label
                            Grid.Row="3"
                            Grid.Column="0"
                            HorizontalTextAlignment="End"
                            Style="{StaticResource TxtOverline_1}"
                            Text="Dog Friendly:" />

                        <controls:RatingView
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource RatingViewStyle}"
                            Value="{Binding SelectedBreed.Dog_friendly}" />
                    </Grid>
                </Border>

                <Grid
                    Grid.Row="1"
                    Grid.RowSpan="10"
                    Margin="-12,0,-12,-12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource background_light},
                                                      Dark={StaticResource background_dark}}"
                    IsVisible="{Binding IsLoadBreeds}">
                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsLoadBreeds}"
                        IsVisible="{Binding IsLoadBreeds}"
                        VerticalOptions="Center"
                        Color="{AppThemeBinding Light={StaticResource violet_9_light},
                                                Dark={StaticResource purple_9_dark}}" />
                </Grid>
            </Grid>
        </ScrollView>

        <BoxView
            Grid.Row="0"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource background_light},
                                    Dark={StaticResource background_dark}}" />

        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding IsBusy}"
            Spacing="10"
            VerticalOptions="Center">
            <ActivityIndicator
                HeightRequest="50"
                IsRunning="{Binding IsBusy}"
                WidthRequest="50"
                Color="{AppThemeBinding Light={StaticResource violet_9_light},
                                        Dark={StaticResource purple_9_dark}}" />

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource TxtSubtitle1_1}"
                Text="Loading"
                TextColor="{AppThemeBinding Light={StaticResource violet_9_light},
                                            Dark={StaticResource purple_9_dark}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>