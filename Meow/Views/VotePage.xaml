<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Meow.Views.VotePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converter="clr-namespace:Meow.Converters"
    xmlns:page="clr-namespace:Meow.Views"
    xmlns:reusablecomponent="clr-namespace:Meow.ReusableComponents"
    xmlns:viewmodel="clr-namespace:Meow.Presentation.ViewModels"
    x:DataType="viewmodel:VoteViewModel">

    <ContentPage.Resources>
        <converter:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        <converter:BoolToErrorTypeConverter x:Key="BoolToErrorTypeConverter" />
        <converter:IsNotNullConverter x:Key="IsNotNullConverter" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <reusablecomponent:TitleViewReusable />
    </Shell.TitleView>

    <Grid Padding="12,0" RowDefinitions="Auto, 8, *, 16, 48, 30">

        <!--  Warning banner (no internet / API error)  -->
        <Border
            x:Name="WarningBanner"
            Grid.Row="0"
            Padding="14,8"
            BackgroundColor="#e15050"
            IsVisible="{Binding WarningMessage, Converter={StaticResource IsNotNullConverter}}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <Label
                    Grid.Column="0"
                    FontFamily="Roboto#700"
                    FontSize="16"
                    Text="⚠"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
                <Label
                    Grid.Column="1"
                    FontFamily="Roboto#500"
                    FontSize="13"
                    Text="{Binding WarningMessage}"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
                <Label
                    Grid.Column="2"
                    FontFamily="Roboto#400"
                    FontSize="11"
                    Opacity="0.8"
                    Text="✕"
                    TextColor="White"
                    VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDismissWarning" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <!--  Success/recovery banner  -->
        <Border
            x:Name="SuccessBanner"
            Grid.Row="0"
            Padding="14,8"
            BackgroundColor="#56dd73"
            IsVisible="{Binding SuccessMessage, Converter={StaticResource IsNotNullConverter}}"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="0">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                <Label
                    Grid.Column="0"
                    FontFamily="Roboto#700"
                    FontSize="16"
                    Text="✓"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
                <Label
                    Grid.Column="1"
                    FontFamily="Roboto#500"
                    FontSize="13"
                    Text="{Binding SuccessMessage}"
                    TextColor="White"
                    VerticalTextAlignment="Center" />
            </Grid>
        </Border>

        <!--  Error/Offline State View (shown only when no data at all)  -->
        <page:ErrorStateView
            Grid.Row="2"
            ErrorType="{Binding IsNoInternet, Converter={StaticResource BoolToErrorTypeConverter}}"
            IsVisible="{Binding HasError}"
            RetryCommand="{Binding RetryCommand}" />

        <!--  Cat image card  -->
        <Border
            x:Name="CatCardBorder"
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light={StaticResource gray_4_light},
                                              Dark={StaticResource gray_4_dark}}"
            IsVisible="{Binding HasError, Converter={StaticResource InvertBooleanConverter}}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="0">
            <Border.Shadow>
                <Shadow
                    Brush="#121212"
                    Offset="0,20"
                    Opacity="0.3"
                    Radius="15" />
            </Border.Shadow>
            <Grid
                Padding="12"
                ColumnDefinitions="*, Auto"
                RowDefinitions="Auto, *">
                <Image
                    x:Name="CatImage"
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Margin="-12"
                    Aspect="AspectFill"
                    IsEnabled="{Binding IsHidden, Converter={StaticResource InvertBooleanConverter}}"
                    Source="{Binding CurrentCat.Url}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ManageFavoriteKittenCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <!--  Floating heart status indicator & favorite button  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    BackgroundColor="#c0585858"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="40">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ManageFavoriteKittenCommand}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <Image
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsBusy, Converter={StaticResource InvertBooleanConverter}}"
                            Source="{Binding ImageHeart}"
                            VerticalOptions="Center"
                            WidthRequest="24" />
                        <ActivityIndicator
                            HeightRequest="24"
                            HorizontalOptions="Center"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            VerticalOptions="Center"
                            WidthRequest="24"
                            Color="#cfbaff" />
                    </Grid>
                </Border>
            </Grid>

        </Border>

        <!--  Placeholder while loading  -->
        <Border
            x:Name="LoadingPlaceholderBorder"
            Grid.Row="2"
            BackgroundColor="{AppThemeBinding Light={StaticResource gray_4_light},
                                              Dark={StaticResource gray_4_dark}}"
            IsVisible="{Binding IsHidden}"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="0">
            <Border.Shadow>
                <Shadow
                    Brush="#121212"
                    Offset="0,20"
                    Opacity="0.3"
                    Radius="15" />
            </Border.Shadow>
            <Grid RowDefinitions="10*,80*,10*">
                <Image Grid.Row="1" Source="icon_brand_bg.png" />
            </Grid>
        </Border>

        <!--  Native Heart Confetti Overlay  -->
        <Grid
            x:Name="HeartConfettiCanvas"
            Grid.Row="2"
            InputTransparent="True"
            IsVisible="False"
            ZIndex="10" />

        <!--  Vote buttons  -->
        <Grid
            Grid.Row="4"
            ColumnDefinitions="*, 16, *"
            IsVisible="{Binding HasError, Converter={StaticResource InvertBooleanConverter}}">
            <Button
                Grid.Column="0"
                BackgroundColor="#56dd73"
                Command="{Binding LoveKittyCommand}"
                ContentLayout="Left,8"
                CornerRadius="12"
                FontAttributes="Bold"
                FontFamily="Roboto#700"
                FontSize="15"
                HeightRequest="48"
                ImageSource="icon_thumb_up.png"
                IsEnabled="{Binding IsTransitioning, Converter={StaticResource InvertBooleanConverter}}"
                Text="LOVE IT"
                TextColor="White" />

            <Button
                Grid.Column="2"
                BackgroundColor="#e15050"
                Command="{Binding GetKittyCommand}"
                ContentLayout="Left,8"
                CornerRadius="12"
                FontAttributes="Bold"
                FontFamily="Roboto#700"
                FontSize="15"
                HeightRequest="48"
                ImageSource="icon_thumb_down.png"
                IsEnabled="{Binding IsTransitioning, Converter={StaticResource InvertBooleanConverter}}"
                Text="NOPE IT"
                TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>