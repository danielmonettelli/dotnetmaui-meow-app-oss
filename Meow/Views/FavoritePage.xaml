<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Meow.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:model="clr-namespace:Meow.Domain.Entities;assembly=Meow.Domain"
    xmlns:reusablecomponent="clr-namespace:Meow.ReusableComponents"
    xmlns:viewModel="clr-namespace:Meow.Presentation.ViewModels"
    x:DataType="viewModel:FavoriteViewModel"
    SizeChanged="ContentPage_SizeChanged">

    <Shell.TitleView>
        <reusablecomponent:TitleViewReusable />
    </Shell.TitleView>

    <Grid RowDefinitions="*">
        <CollectionView
            Grid.Row="0"
            Margin="12,20,12,12"
            ItemsSource="{Binding FavoriteCats}"
            ItemSizingStrategy="MeasureFirstItem"
            SelectedItem="{Binding SelectedFavoriteCat}"
            SelectionMode="Single">
            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="16"
                    Orientation="Vertical"
                    Span="{Binding Columns}"
                    VerticalItemSpacing="16" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:FavoriteCatResponse">
                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource gray_4_light},
                                                          Dark={StaticResource gray_4_dark}}"
                        HeightRequest="160"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid InputTransparent="True">
                            <Image
                                Aspect="AspectFill"
                                InputTransparent="True">
                                <Image.Source>
                                    <UriImageSource
                                        CachingEnabled="True"
                                        CacheValidity="14.00:00:00"
                                        Uri="{Binding Image.Url}" />
                                </Image.Source>
                            </Image>

                            <Border
                                BackgroundColor="#66121212"
                                HeightRequest="32"
                                HorizontalOptions="End"
                                InputTransparent="True"
                                Margin="0"
                                StrokeShape="{RoundRectangle CornerRadius='0,16,0,8'}"
                                StrokeThickness="0"
                                VerticalOptions="Start"
                                WidthRequest="32">
                                <Image
                                    HeightRequest="18"
                                    HorizontalOptions="Center"
                                    InputTransparent="True"
                                    Source="icon_heart_solid.png"
                                    VerticalOptions="Center"
                                    WidthRequest="18" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <ContentView>
                    <StackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Label
                            Style="{StaticResource TxtCaption_1}"
                            Text="You don't have favorite kitties on your list, meow!" />
                    </StackLayout>
                </ContentView>
            </CollectionView.EmptyView>
        </CollectionView>

        <BoxView
            Grid.Row="0"
            IsVisible="{Binding IsBusy}"
            Color="{AppThemeBinding Light={StaticResource background_light},
                                    Dark={StaticResource background_dark}}" />

        <VerticalStackLayout
            HorizontalOptions="Center"
            IsVisible="{Binding IsBusy}"
            Spacing="10"
            VerticalOptions="Center">
            <ActivityIndicator
                HeightRequest="50"
                IsRunning="{Binding IsBusy}"
                WidthRequest="50"
                Color="{AppThemeBinding Light={StaticResource violet_9_light},
                                        Dark={StaticResource purple_9_dark}}" />

            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource TxtSubtitle1_1}"
                Text="Loading"
                TextColor="{AppThemeBinding Light={StaticResource violet_9_light},
                                            Dark={StaticResource purple_9_dark}}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>